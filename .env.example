NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

PAIRING_CODE_TTL_MINUTES=10
PAIRING_POLL_INTERVAL_SECONDS=5

SWAGGER_ENABLED=true

HTTPS_ENABLED=false
SSL_KEY_PATH=/etc/letsencrypt/live/server1.workagentic.us/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/server1.workagentic.us/fullchain.pem

SEED_ADMIN_EMAIL=admin@timecamp.local
SEED_ADMIN_PASSWORD=ChangeMe123!
