        <mxCell id="e3" value="manager_id (self)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;exitX=1;exitY=0.2;entryX=1;entryY=0.4;" edge="1" parent="1" source="t_employees" target="t_employees">
          <mxGeometry relative="1" as="geometry" />
