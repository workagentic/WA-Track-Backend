{
  "info": {
    "_postman_id": "9c7a1e3e-4b2a-4d7f-8f1a-6a1b0c9e2f10",
    "name": "WA Track Backend API",
    "description": "Full request collection for the WA Track (formerly TimeCamp) NestJS backend — auth, pairing, employees, departments, clients, tasks, time entries, device sessions, reports, roles, and the deletion audit API.\n\n**Setup**\n1. Run the backend locally (`npm run start:dev`) so it's reachable at `{{base_url}}`.\n2. Run `npm run seed` once against your DB — this creates the four roles and a seeded ADMIN user (`admin_email`/`admin_password`).\n3. Run **Auth > Login** — its test script stores the returned `accessToken` into the `token` collection variable, which every other request inherits via the collection-level Bearer auth.\n\nThis collection intentionally only declares 5 variables (`base_url`, `host`, `token`, `admin_email`, `admin_password`). Every resource id used in a URL or body (employee/department/client/task ids, etc.) is a literal placeholder value — replace it with the real id returned from the matching `Create`/`List` response as you go.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "host", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "admin_email", "value": "admin@timecamp.local", "type": "string" },
    { "key": "admin_password", "value": "ChangeMe123!", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Web portal login and access/refresh token rotation. Neither route uses Bearer auth — Login has no auth requirement, and Refresh reads the refresh token from the request body (passport 'jwt-refresh' strategy), not the Authorization header.",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Web portal login. On success, the test script stores the returned `accessToken` into the `token` collection variable used by every other request. The `refreshToken` is also returned in the response body — copy it manually into 'Refresh Token' if you need to test rotation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.collectionVariables.set('token', data.accessToken);",
                  "  console.log('Stored accessToken into the token variable. refreshToken (copy manually if needed):', data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN_FROM_LOGIN_RESPONSE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Rotates the access/refresh token pair. The refresh token is read from the JSON body, not the Authorization header — paste the `refreshToken` value from a Login response above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pairing (Desktop App device-code flow)",
      "description": "The desktop app's TV-style device-code pairing flow. 'Create Device Code' and 'Poll Token' are called by the desktop app itself (no login); 'Confirm Pairing' is called by the logged-in web portal user.",
      "item": [
        {
          "name": "Create Device Code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/pairing/device-code",
              "host": ["{{base_url}}"],
              "path": ["auth", "pairing", "device-code"]
            },
            "description": "Called by the desktop app on launch. Returns { deviceCode, userCode, expiresAt, pollIntervalSeconds } — copy userCode into 'Confirm Pairing' and deviceCode into 'Poll Token'."
          }
        },
        {
          "name": "Confirm Pairing (Web Portal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userCode\": \"PASTE_USER_CODE_FROM_DEVICE_CODE_RESPONSE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/pairing/confirm",
              "host": ["{{base_url}}"],
              "path": ["auth", "pairing", "confirm"]
            },
            "description": "Requires Bearer auth (logged-in web portal user). Links the userCode from 'Create Device Code' to the current employee."
          }
        },
        {
          "name": "Poll Token (Desktop App)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceCode\": \"PASTE_DEVICE_CODE_FROM_DEVICE_CODE_RESPONSE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/pairing/token",
              "host": ["{{base_url}}"],
              "path": ["auth", "pairing", "token"]
            },
            "description": "Called repeatedly by the desktop app until 'Confirm Pairing' has been run. Returns 428 (authorization_pending) until then, then 201 with a device access/refresh token pair."
          }
        }
      ]
    },
    {
      "name": "Employees",
      "description": "Replace the literal '1' ids below with real ids from your database (see List Employees / List Roles / List Departments). roleId reference from the seed script's insertion order: 1=EMPLOYEE, 2=MANAGER, 3=HR, 4=ADMIN — confirm against GET /roles rather than assuming.",
      "item": [
        {
          "name": "List Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["employees"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "MANAGER sees only their own department; HR/ADMIN see everyone. Soft-deleted employees are excluded automatically. Offset-based pagination — response is { data: [...], total, page, limit, totalPages }."
          }
        },
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@company.com\",\n  \"username\": \"jane.doe\",\n  \"password\": \"StrongPassw0rd!\",\n  \"departmentId\": 1,\n  \"roleId\": 1,\n  \"status\": \"active\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/employees", "host": ["{{base_url}}"], "path": ["employees"] },
            "description": "Requires HR or ADMIN. `username` is set once here and can never be changed afterward (omitted from the update DTO)."
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane A. Doe\",\n  \"status\": \"active\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/employees/1",
              "host": ["{{base_url}}"],
              "path": ["employees", "1"]
            },
            "description": "Requires HR or ADMIN. `password` and `username` are rejected here (400) — use the dedicated password endpoint; username is immutable."
          }
        },
        {
          "name": "Change Employee Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewStrongPassw0rd!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/employees/1/password",
              "host": ["{{base_url}}"],
              "path": ["employees", "1", "password"]
            },
            "description": "Requires HR or ADMIN."
          }
        },
        {
          "name": "Soft Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees/1",
              "host": ["{{base_url}}"],
              "path": ["employees", "1"]
            },
            "description": "Requires HR or ADMIN. Sets deletedAt/deletedBy — the employee's Tasks/TimeEntries/Clients are left untouched."
          }
        },
        {
          "name": "Restore Employee",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees/1/restore",
              "host": ["{{base_url}}"],
              "path": ["employees", "1", "restore"]
            },
            "description": "Requires HR or ADMIN."
          }
        }
      ]
    },
